# ======================================================================
# APIForge 环境变量示例
# 使用方法：复制为 .env 并填入真实值（.env 已被 .gitignore 忽略，请勿提交）。
# ======================================================================

# LLM 提供商配置（Integration Planner / Repair Loop 阶段使用）
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# 待集成的第三方 OpenAPI Spec 位置（URL 或本地文件路径）
OPENAPI_SPEC_URL=
