# ======================================================================
# APIForge 环境变量示例
# 使用方法：复制为 .env 并填入真实值（.env 已被 .gitignore 忽略，请勿提交）。
# ======================================================================

# DeepSeek LLM 配置（LLM Repair Applier / DeepSeekLLMClient 使用）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=

# 待集成的第三方 OpenAPI Spec 位置（URL 或本地文件路径）
OPENAPI_SPEC_URL=
